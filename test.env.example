# Copy to .env and edit. Next.js loads it automatically.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://btpanel:change-me@127.0.0.1:5432/btpanel

# false on a real server: no sample accounts or sample fleet. The first
# account you register on /register becomes the panel owner.
SEED_DEMO=false

# Force Secure cookies behind HTTPS (otherwise auto-detected from Origin)
COOKIE_SECURE=true

# Port the panel listens on; nginx proxies to 127.0.0.1:$PORT
PORT=3000
